import android.Manifest
import android.os.Build
import androidx.activity.result.contract.ActivityResultContracts

// Badha permissions ek function ma
fun getRequiredPermissions(): Array<String> {
    return when {
        Build.VERSION.SDK_INT >= Build.VERSION_CODES.UPSIDE_DOWN_CAKE -> {
            // Android 14+
            arrayOf(
                Manifest.permission.READ_MEDIA_IMAGES,
                Manifest.permission.READ_MEDIA_VIDEO,
                Manifest.permission.READ_MEDIA_VISUAL_USER_SELECTED
            )
        }
        Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU -> {
            // Android 13
            arrayOf(
                Manifest.permission.READ_MEDIA_IMAGES,
                Manifest.permission.READ_MEDIA_VIDEO
            )
        }
        else -> {
            // Android 12 ane niche
            arrayOf(Manifest.permission.READ_EXTERNAL_STORAGE)
        }
    }
}

private val permissionLauncher =
    registerForActivityResult(
        ActivityResultContracts.RequestMultiplePermissions()
    ) { results ->
        val imageOk = results[Manifest.permission.READ_MEDIA_IMAGES]
            ?: results[Manifest.permission.READ_EXTERNAL_STORAGE]
            ?: false

        val videoOk = results[Manifest.permission.READ_MEDIA_VIDEO]
            ?: results[Manifest.permission.READ_EXTERNAL_STORAGE]
            ?: false

        // Android 14 partial access check
        val partialOk = results[Manifest.permission.READ_MEDIA_VISUAL_USER_SELECTED]
            ?: false

        when {
            imageOk && videoOk -> loadAllMedia()
            partialOk         -> loadSelectedMedia()
            else              -> showPermissionDeniedUI()
        }
    }

fun askMediaPermission() {
    permissionLauncher.launch(getRequiredPermissions())
}
class ContactAdapter(
    private val contacts: List<Contact>
) : RecyclerView.Adapter<ContactAdapter.ContactViewHolder>() {

    // ── ViewHolder ──────────────────────────────────────────────
    inner class ContactViewHolder(itemView: View) : RecyclerView.ViewHolder(itemView) {
        val tvAvatar: TextView   = itemView.findViewById(R.id.tvAvatar)
        val tvName: TextView     = itemView.findViewById(R.id.tvName)
        val tvPhone: TextView    = itemView.findViewById(R.id.tvPhone)
        val btnCall: ImageButton = itemView.findViewById(R.id.btnCall)
    }

    // ── Create ViewHolder ────────────────────────────────────────
    override fun onCreateViewHolder(parent: ViewGroup, viewType: Int): ContactViewHolder {
        val view = LayoutInflater.from(parent.context)
            .inflate(R.layout.item_contact, parent, false)
        return ContactViewHolder(view)
    }

    // ── Bind Data ────────────────────────────────────────────────
    override fun onBindViewHolder(holder: ContactViewHolder, position: Int) {
        val contact = contacts[position]

        // Name ni first letter avatar ma dikhavvo
        holder.tvAvatar.text = contact.name.first().uppercaseChar().toString()
        holder.tvName.text   = contact.name
        holder.tvPhone.text  = contact.phoneNumber

        // Call button click
        holder.btnCall.setOnClickListener {
            makeCall(holder, contact.phoneNumber)
        }

        // Whole row click karo to pan call thay
        holder.itemView.setOnClickListener {
            makeCall(holder, contact.phoneNumber)
        }
    }

    override fun getItemCount(): Int = contacts.size

    // ── Phone Call Function ──────────────────────────────────────
    private fun makeCall(holder: ContactViewHolder, phoneNumber: String) {
        val context = holder.itemView.context

        // CALL_PHONE permission check
        if (ContextCompat.checkSelfPermission(context, Manifest.permission.CALL_PHONE)
            == PackageManager.PERMISSION_GRANTED
        ) {
            // Permission chhe — seedho call karo
            val callIntent = Intent(Intent.ACTION_CALL).apply {
                data = Uri.parse("tel:$phoneNumber")
            }
            context.startActivity(callIntent)
        } else {
            // Permission nathi — Dialer open karo (user manually call kare)
            val dialIntent = Intent(Intent.ACTION_DIAL).apply {
                data = Uri.parse("tel:$phoneNumber")
            }
            context.startActivity(dialIntent)
            Toast.makeText(context, "Call permission nathi, dialer khulyo", Toast.LENGTH_SHORT).show()
        }
    }
}
